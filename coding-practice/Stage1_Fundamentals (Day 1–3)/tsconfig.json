{
  "compilerOptions": {
    "target": "es2017",              // modern JS features
    "module": "commonjs",            // matches your package.json type
    "rootDir": "./",                 // where your .ts files live
    "outDir": "./dist",              // compiled .js files go here
    "strict": true,                  // enable strict type checking
    "esModuleInterop": true,         // allow default imports from CommonJS
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true             // skip type checks for node_modules
  },
  "include": ["*.ts"],               // compile all .ts files in this folder
  "exclude": ["node_modules"]        // ignore dependencies
}
